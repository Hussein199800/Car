{
  "name": "sakina-adhkar",
  "version": "1.0.0",
  "private": true,
  "description": "سكينة - رفيقك الروحي اليومي: أذكار، أدعية، مواقيت الصلاة، المسبحة",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "npm run build && npx http-server www -p 8090 -c-1",
    "sync": "npm run build && npx cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node tests/e2e/run.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "adhan": "^4.4.6",
    "esbuild": "^0.25.12"
  }
}

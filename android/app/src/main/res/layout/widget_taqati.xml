<?xml version="1.0" encoding="utf-8"?>
<!-- أداة الشاشة الرئيسية: نسبة البطارية والحمل والألواح وحالة الاتصال بنظرة واحدة -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_soc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_empty"
            android:textColor="#FFFFFF"
            android:textDirection="rtl"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#C7D2FE"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_bat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E2E8F0"
        android:textDirection="rtl"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_load"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFF"
            android:textDirection="rtl"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_pv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FDE68A"
            android:textDirection="rtl"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#94A3B8"
        android:textDirection="rtl"
        android:textSize="11sp" />
</LinearLayout>
